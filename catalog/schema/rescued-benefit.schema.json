{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mycard-benefits.invalid/schema/rescued-benefit-1.0.0.json",
  "title": "MyCard Benefits rescued research record",
  "description": "The plain JSON shape used to preserve deduplicated researched benefit records before the candidate machinery is removed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "offering_id",
    "title",
    "benefit_type",
    "category",
    "allowance",
    "eligibility",
    "conditions",
    "exclusions",
    "redemption_steps",
    "provider",
    "effective_from",
    "effective_to",
    "end_date_known",
    "source_url",
    "source_policy_class",
    "content_sha256",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "offering_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "benefit_type": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "allowance": {
      "type": "object"
    },
    "eligibility": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predicate"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "redemption_steps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provider": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "effective_from": {
      "$ref": "#/$defs/nullableDate"
    },
    "effective_to": {
      "$ref": "#/$defs/nullableDate"
    },
    "end_date_known": {
      "type": "boolean"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "source_policy_class": {
      "enum": [
        "administering_terms",
        "issuer_document",
        "network_rule",
        "merchant_terms",
        "regulatory_context",
        "discovery_only"
      ]
    },
    "content_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_claimed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "state": {
      "enum": [
        "verified",
        "check_before_use",
        "sources_differ"
      ]
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_divergence": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceDivergence"
      }
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "review_tier": {
      "type": "string",
      "minLength": 1
    },
    "rule_version": {
      "type": "integer"
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts_with": {
      "type": "array"
    },
    "value_class": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "sources_differ"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "provenance"
        ]
      }
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nullableDate": {
      "anyOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceDivergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "benefit_type",
        "category",
        "allowance",
        "effective_from"
      ],
      "properties": {
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_policy_class": {
          "enum": [
            "administering_terms",
            "issuer_document",
            "network_rule",
            "merchant_terms",
            "regulatory_context",
            "discovery_only"
          ]
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "benefit_type": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "allowance": {
          "type": "object"
        },
        "effective_from": {
          "$ref": "#/$defs/nullableDate"
        },
        "effective_to": {
          "$ref": "#/$defs/nullableDate"
        },
        "end_date_known": {
          "type": "boolean"
        }
      }
    },
    "predicate": {
      "type": "object",
      "required": [
        "field",
        "operator"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "equals",
            "in",
            "not_in",
            "gte",
            "lte",
            "between",
            "exists"
          ]
        },
        "value": {}
      },
      "additionalProperties": true
    }
  }
}
