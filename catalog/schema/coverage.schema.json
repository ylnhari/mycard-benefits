{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "description", "source_slots", "benefit_categories", "offering_overrides"],
  "properties": {
    "manifest_version": {"const": "1"},
    "description": {"type": "string", "minLength": 1},
    "source_slots": {"type": "array", "const": ["issuer_product_page_terms", "issuer_program_terms", "network_wide_terms", "merchant_partner_terms", "program_administrator_terms"]},
    "benefit_categories": {"type": "array", "minItems": 17, "uniqueItems": true},
    "offering_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "required_slots", "sources"],
        "properties": {
          "scope": {"type": "object", "additionalProperties": false, "required": ["offering_id", "product_variant_id", "issuer_id", "network_id", "co_brand_id"], "properties": {
            "offering_id": {"type": "string"}, "product_variant_id": {"type": "string"}, "issuer_id": {"type": "string"}, "network_id": {"type": "string"}, "co_brand_id": {"type": ["string", "null"]}
          }},
          "required_slots": {"type": "array", "items": {"type": "string", "enum": ["issuer_product_page_terms", "issuer_program_terms", "network_wide_terms", "merchant_partner_terms", "program_administrator_terms"]}, "uniqueItems": true},
          "sources": {"type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["slot", "source_id", "url", "owner", "source_policy_class", "source_tier", "scope", "adapter", "observation_ids", "evidence_ids", "verification_state", "claim_ids"],
            "properties": {
              "slot": {"type": "string", "enum": ["issuer_product_page_terms", "issuer_program_terms", "network_wide_terms", "merchant_partner_terms", "program_administrator_terms"]},
              "source_id": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"}, "owner": {"type": "string", "minLength": 1}, "source_policy_class": {"type": "string", "enum": ["administering_terms", "issuer_document", "network_rule", "merchant_terms", "regulatory_context", "discovery_only"]}, "source_tier": {"type": "integer", "minimum": 1, "maximum": 6}, "scope": {"type": "object"}, "adapter": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}}, "observation_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "verification_state": {"type": "string", "enum": ["approved"]}, "claim_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          }}
        }
      }
    }
  }
}
