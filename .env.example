# Optional local configuration. Copy to .env; never commit populated values.
MYCARD_BENEFITS_PORT=
MYCARD_BENEFITS_DATA_DIR=
MYCARD_BENEFITS_NO_BROWSER=
MYCARD_BENEFITS_NTFY_ENABLED=0

# Optional notification integration. Notification text never includes card
# names, vault fields, or personal data.
NTFY_TOPIC=

# Optional model providers for public-source parsing/Q&A only. Vault values are
# never sent to any provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
